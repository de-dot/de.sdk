{
  "name": "@de./sdk",
  "version": "1.0.4",
  "description": "Complete SDK pack for MSI (Map Service Interface), IoTClient and DClient services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.d.ts"
    }
  },
  "author": "SCOREX Corporation",
  "private": false,
  "scripts": {
    "build:tsc": "rimraf ./dist && tsc",
    "build:webpack": "WEBPACK_ENV=build webpack",
    "build:copy-types": "mkdir -p dist/types && cp -r src/types/* dist/types/",
    "compile": "yarn build:tsc && yarn build:webpack && yarn build:copy-types",
    "prepack": "yarn run compile",
    "test": "Echo 'Error: No test specified' && exit 1",
    "test:auth": "yarn build:tsc && jest test/auth.test.js",
    "test:client": "yarn build:tsc && jest test/client.test.js",
    "test:order": "yarn build:tsc && jest test/order.test.js",
    "test:event": "yarn build:tsc && jest test/event.test.js"
  },
  "dependencies": {
    "@de./types": "file:../de.types",
    "events": "^3.3.0",
    "iframe.io": "^1.1.0",
    "node-fetch": "2.6.1",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node-fetch": "^2.6.3",
    "expect.js": "^0.3.1",
    "jest": "^29.7.0",
    "rimraf": "^4.4.0",
    "ts-jest": "^29.0.5",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.2",
    "webpack": "^5.77.0",
    "webpack-cli": "^5.0.1"
  },
  "directories": {
    "dist": "dist/",
    "docs": "docs/",
    "test": "test/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/de-dot/de.sdk"
  },
  "keywords": []
}
